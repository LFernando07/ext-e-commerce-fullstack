// Configuración de Prisma ORM para Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. MODELO DE PEDIDOS A PLAZOS (Nenis Club / PedidosManager)
// ─────────────────────────────────────────────────────────────
model Pedido {
  id              String   @id @default(cuid())
  neniId          String   @default("usr_neni_001")
  clienteNombre   String
  concepto        String
  monto           Float
  plazosQuincenas Int      @default(4)
  montoQuincenal  Float
  estado          String   @default("pendiente") // 'pendiente' | 'aprobado' | 'en_entrega' | 'completado'
  fechaCreacion   DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([estado])
  @@index([neniId])
  @@map("pedidos")
}

// ─────────────────────────────────────────────────────────────
// 2. MODELO DE PEDIDOS CAPSULE CORP (Dragon Ball Z E-Commerce)
// ─────────────────────────────────────────────────────────────
model CapsuleOrder {
  id             String             @id @default(cuid())
  orderCode      String             @unique // Ej. CC-MVFI7WC9-742
  customerName   String
  address        String             @default("Capital del Oeste, Tierra")
  paymentMethod         String             @default("Zeni en Efectivo")
  paymentStatus         String             @default("pending") // 'pending' | 'paid' | 'failed'
  stripeSessionId       String?            @unique
  stripePaymentIntentId String?
  totalZeni             Float
  itemsPurchased        Int                @default(1)
  status                String             @default("despachado") // 'despachado' | 'en_camino' | 'entregado'
  items                 CapsuleOrderItem[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@map("capsule_orders")
}

model CapsuleOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     CapsuleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name      String
  quantity  Int          @default(1)
  unitPrice Float
  image     String?

  @@index([orderId])
  @@map("capsule_order_items")
}

// ─────────────────────────────────────────────────────────────
// 3. MODELO DE USUARIOS Y AUTENTICACIÓN (Centralizado en Supabase)
// ─────────────────────────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  email            String
  password         String
  name             String
  businessName     String    @default("Capsule Corp Explorer")
  businessCategory String    @default("Coleccionables")
  graduationLevel  String    @default("Starter") // 'Starter' | 'Growth' | 'Trusted'
  creditLimit      Float     @default(5000)
  availableCredit  Float     @default(5000)
  role             String    @default("neni") // 'neni' | 'admin'
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// 4. MODELO DE CARRITOS ABANDONADOS (Recuperación por Resend)
// ─────────────────────────────────────────────────────────────
model AbandonedCart {
  id            String    @id @default(cuid())
  userId        String?
  email         String
  customerName  String    @default("Viajero Hoi-Poi")
  items         Json      // Array con { productId, name, priceInZeni, quantity, image }
  totalZeni     Float
  recoveryToken String    @unique @default(cuid())
  status        String    @default("abandoned") // 'active' | 'abandoned' | 'recovered'
  emailSent     Boolean   @default(false)
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@map("abandoned_carts")
}

